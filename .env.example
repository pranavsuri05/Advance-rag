# Select the LLM provider: groq (default/primary) or gemini (optional). Both configurations can stay in this file.
LLM_PROVIDER=groq

# --- Gemini ---
# Google Gemini API key (https://aistudio.google.com/apikey). Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash   # model availability depends on your account; set to a model your key can use

# --- Optional generation controls (leave unset to use the model's defaults) ---
# Thinking tokens count toward output tokens and add latency/cost. Set AT MOST ONE of these two:
#   GEMINI_THINKING_LEVEL  = minimal | low | medium | high   (Gemini 3 style models)
#   GEMINI_THINKING_BUDGET = integer token budget, 0 = off  (Gemini 2.5 style models)
# Whether a given model accepts them depends on the model; if the API rejects the setting, unset it.
# GEMINI_THINKING_LEVEL=low
# GEMINI_THINKING_BUDGET=

# Output-token caps (thinking tokens are included, so keep them well above the expected answer length).
GEMINI_MAX_OUTPUT_TOKENS=2048          # answer_generation
GEMINI_MAX_OUTPUT_TOKENS_SHORT=1024    # JSON utility calls: rewrite, decomposition, grading, corrective query, judge

# Retries for transient 5xx/network errors in our own wrapper (the SDK's hidden retries are disabled).
# 0 = never retry, so each logical call is exactly one HTTP request. 429/auth/404 are never retried.
LLM_MAX_RETRIES=2

# --- Groq (OpenAI-compatible API, https://console.groq.com/keys) ---
GROQ_API_KEY=
# Model ids available differ per account (GET https://api.groq.com/openai/v1/models). Free-tier limits are per account:
# check https://console.groq.com/settings/limits
GROQ_MODEL=qwen/qwen3.8-27b

# Provider-neutral output caps (fall back to the GEMINI_MAX_OUTPUT_TOKENS* values above when unset).
# LLM_MAX_OUTPUT_TOKENS=2048
# LLM_MAX_OUTPUT_TOKENS_SHORT=1024
